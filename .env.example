# PowerFit Environment Variables
# ----------------------------------
# In production: set these in Vercel Environment Variables
# In development: copy this file to .env.local and fill in your keys

# Groq AI API Key (server-side only, configure in Vercel)
# GROQ_API_KEY=your_groq_key_here

# Supabase (required for data persistence)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here

# Optional: enable only on an isolated preview deployment with fictitious data
# VITE_ENABLE_DEMO_MODE=false
